    {
      "@id": "mcdonalds:RefrigerationState",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "RefrigerationState",
      "rdfs:comment": "Live state from <StoreId>.Cooler.State / .Freezer.State.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:RefrigerationStateEnum",
      "@type": "owl:Class",
      "rdfs:label": "Refrigeration State",
      "rdfs:comment": "State codes written by the simulator for walk-in coolers and freezers (tag <Store>.Cooler.State / .Freezer.State). 40-43 are faults.",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:integer",
      "enumMembers": [
        {"rdfs:label": "Off Cycle", "enumKey": 0, "enumName": "OffCycle"},
        {"rdfs:label": "Cooling", "enumKey": 10, "enumName": "Cooling"},
        {"rdfs:label": "Holding", "enumKey": 20, "enumName": "Holding"},
        {"rdfs:label": "Door Open", "enumKey": 21, "enumName": "DoorOpen"},
        {"rdfs:label": "Stocking", "enumKey": 22, "enumName": "Stocking"},
        {"rdfs:label": "Defrost", "enumKey": 30, "enumName": "Defrost"},
        {"rdfs:label": "Fault - Door/Seal", "enumKey": 40, "enumName": "FaultDoorSeal"},
        {"rdfs:label": "Fault - Compressor", "enumKey": 41, "enumName": "FaultCompressor"},
        {"rdfs:label": "Fault - Temperature Sensor", "enumKey": 42, "enumName": "FaultTemperatureSensor"},
        {"rdfs:label": "Fault - Evaporator Fan", "enumKey": 43, "enumName": "FaultEvaporatorFan"}
      ]
    },
    {
      "@id": "mcdonalds:ReliabilityGrade",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "ReliabilityGrade",
      "rdfs:comment": "ReliabilityGradeEnum: 4 A Swirl Legend, 3 B Dependable Dip, 2 C Coin Flip, 1 D Ask Before You Order, 0 F Certified Broken.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityGradeEnum",
      "@type": "owl:Class",
      "rdfs:label": "Soft Serve Reliability Grade",
      "rdfs:comment": "Grade from ReliabilityScore (uptime): A >= 97, B >= 90, C >= 80, D >= 70, F below 70.",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:integer",
      "enumMembers": [
        {"rdfs:label": "A - Swirl Legend", "enumKey": 4, "enumName": "A"},
        {"rdfs:label": "B - Dependable Dip", "enumKey": 3, "enumName": "B"},
        {"rdfs:label": "C - Coin Flip", "enumKey": 2, "enumName": "C"},
        {"rdfs:label": "D - Ask Before You Order", "enumKey": 1, "enumName": "D"},
        {"rdfs:label": "F - Certified Broken", "enumKey": 0, "enumName": "F"}
      ]
    },
    {
      "@id": "mcdonalds:ReliabilityGradeOf",
      "@type": "fno:Function",
      "rdfs:label": "Reliability Grade",
      "rdfs:comment": "ReliabilityGradeEnum from the score: A (4) >= 97, B (3) >= 90, C (2) >= 80, D (1) >= 70, F (0) below.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:ReliabilityGradeOf/param/reliabilityScore"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:ReliabilityGradeOf/output/grade"}]
      }
    },
    {
      "@id": "mcdonalds:ReliabilityGradeOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (reliabilityScore.Value == null) return new TVQ(reliabilityScore.Timestamp, null, 0);\ndouble s = System.Convert.ToDouble(reliabilityScore.Value);\nint g = s >= 97 ? 4 : s >= 90 ? 3 : s >= 80 ? 2 : s >= 70 ? 1 : 0;\nreturn new TVQ(reliabilityScore.Timestamp, g, reliabilityScore.Quality);"
    },
    {
      "@id": "mcdonalds:ReliabilityGradeOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:ReliabilityGradeOf"},
      "fno:implementation": {"@id": "mcdonalds:ReliabilityGradeOf/impl"}
    },
    {
      "@id": "mcdonalds:ReliabilityGradeOf/output/grade",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/grade"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityGradeOf/param/reliabilityScore",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/reliabilityScore"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityScore",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "ReliabilityScore",
      "rdfs:comment": "0-100, from uptime: 70% x Uptime7d + 30% x Uptime24h.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf",
      "@type": "fno:Function",
      "rdfs:label": "Reliability Score",
      "rdfs:comment": "Soft serve reliability, 0-100, from uptime: 70% of the 7-day uptime plus 30% of the 24-hour uptime (recent outages weigh more without letting one bad day define the machine).",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:ReliabilityScoreOf/param/uptime7d"}, {"@id": "mcdonalds:ReliabilityScoreOf/param/uptime24h"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:ReliabilityScoreOf/output/score"}]
      }
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "var ts = uptime7d.Timestamp > uptime24h.Timestamp ? uptime7d.Timestamp : uptime24h.Timestamp;\nif (uptime7d.Value == null || uptime24h.Value == null) return new TVQ(ts, null, 0);\ndouble s = 0.7 * System.Convert.ToDouble(uptime7d.Value) + 0.3 * System.Convert.ToDouble(uptime24h.Value);\nreturn new TVQ(ts, System.Math.Round(System.Math.Clamp(s, 0.0, 100.0), 1), uptime7d.Quality);"
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:ReliabilityScoreOf"},
      "fno:implementation": {"@id": "mcdonalds:ReliabilityScoreOf/impl"}
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf/output/score",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/score"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf/param/uptime24h",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/uptime24h"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ReliabilityScoreOf/param/uptime7d",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/uptime7d"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:RepairTask",
      "@type": "owl:Class",
      "rdfs:label": "Repair Task",
      "rdfs:comment": "The known fix for a service condition on a class of store equipment: minimum level, required certifications (requiresCertification) and parts (requiresPart).",
      "rdfs:subClassOf": [
        {"@id": "atlas:NodeBase"},
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Name"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:EquipmentClassCode"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:RepairTaskCode"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:ConditionAnswered"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Symptom"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:MinLevelRank"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:EstMinutes"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        }
      ]
    },
    {
      "@id": "mcdonalds:RepairTaskCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "RepairTaskCode",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:RestaurantHours",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "RestaurantHours",
      "rdfs:comment": "Lobby hours as published, e.g. '05:00-23:00', '24/7' or a per-day schedule.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:RestaurantName",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "RestaurantName",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:RoadMiles",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "RoadMiles",
      "rdfs:comment": "Estimated road miles (great-circle x 1.3).",
      "rdfs:range": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:ServiceCondition",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "ServiceCondition",
      "rdfs:comment": "ServiceConditionEnum: 0 Healthy, 1 Warning (undetected), 2 Danger (undetected), 3 Fault (detected: a fault state is showing).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ServiceConditionEnum",
      "@type": "owl:Class",
      "rdfs:label": "Service Condition",
      "rdfs:comment": "What a technician would find: 0 Healthy; 1/2 drifting out of band with no fault showing (undetected); 3 a fault state is showing (the store already knows).",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:integer",
      "enumMembers": [
        {"rdfs:label": "Healthy", "enumKey": 0, "enumName": "Healthy"},
        {"rdfs:label": "Warning (undetected)", "enumKey": 1, "enumName": "WarningUndetected"},
        {"rdfs:label": "Danger (undetected)", "enumKey": 2, "enumName": "DangerUndetected"},
        {"rdfs:label": "Fault (detected)", "enumKey": 3, "enumName": "FaultDetected"}
      ]
    },
    {
      "@id": "mcdonalds:ServiceConditionOf",
      "@type": "fno:Function",
      "rdfs:label": "Service Condition",
      "rdfs:comment": "ServiceConditionEnum from the health index and the live state code: a fault state (40+) means the store already knows (3); otherwise below 40 = Danger undetected (2), below 70 = Warning undetected (1), else Healthy (0).",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:ServiceConditionOf/param/healthIndex"}, {"@id": "mcdonalds:ServiceConditionOf/param/state"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:ServiceConditionOf/output/condition"}]
      }
    },
    {
      "@id": "mcdonalds:ServiceConditionOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "var ts = healthIndex.Timestamp > state.Timestamp ? healthIndex.Timestamp : state.Timestamp;\nif (state.Value != null && System.Convert.ToInt32(state.Value) >= 40) return new TVQ(ts, 3, state.Quality);\nif (healthIndex.Value == null) return new TVQ(ts, null, 0);\ndouble i = System.Convert.ToDouble(healthIndex.Value);\nreturn new TVQ(ts, i < 40 ? 2 : (i < 70 ? 1 : 0), healthIndex.Quality);"
    },
    {
      "@id": "mcdonalds:ServiceConditionOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:ServiceConditionOf"},
      "fno:implementation": {"@id": "mcdonalds:ServiceConditionOf/impl"}
    },
    {
      "@id": "mcdonalds:ServiceConditionOf/output/condition",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/condition"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ServiceConditionOf/param/healthIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/healthIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ServiceConditionOf/param/state",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/state"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ServiceTruck",
      "@type": "owl:Class",
      "rdfs:label": "Service Truck",
      "rdfs:comment": "A fleet van. Carries a daily-counted parts inventory (carriesPart edges).",
      "rdfs:subClassOf": [
        {"@id": "atlas:NodeBase"},
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Name"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:TruckId"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Make"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Model"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:ModelYear"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:LicensePlate"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        }
      ]
    },
    {
      "@id": "mcdonalds:Serving7d",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Serving7d",
      "rdfs:comment": "% of the last 7 days actually serving (state 0). Heat treat and mix low count against it: what customers experience.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:SoftServeConditionOf",
      "@type": "fno:Function",
      "rdfs:label": "Soft Serve Condition",
      "rdfs:comment": "Soft serve has no analog signal: Needs Service (40) = Fault detected (3), anything else Healthy (0).",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:SoftServeConditionOf/param/state"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:SoftServeConditionOf/output/condition"}]
      }
    },
    {
      "@id": "mcdonalds:SoftServeConditionOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (state.Value == null) return new TVQ(state.Timestamp, null, 0);\nreturn new TVQ(state.Timestamp, System.Convert.ToInt32(state.Value) >= 40 ? 3 : 0, state.Quality);"
    },
    {
      "@id": "mcdonalds:SoftServeConditionOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:SoftServeConditionOf"},
      "fno:implementation": {"@id": "mcdonalds:SoftServeConditionOf/impl"}
    },
    {
      "@id": "mcdonalds:SoftServeConditionOf/output/condition",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/condition"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:SoftServeConditionOf/param/state",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/state"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
