      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:HourlyAverage",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "HourlyAverage",
      "rdfs:comment": "Mean of the most recent hour of steady-state operation of the unit's health signal (tag <StoreId>.<Class>.<Signal>Avg1h, written every 5 min by tools/health_baseline.py).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:IndexPassThrough",
      "@type": "fno:Function",
      "rdfs:label": "Index Pass-Through",
      "rdfs:comment": "Returns its input unchanged. Lets a store carry each unit's HealthIndex as a calculated column of the health matrix (a ReferenceStrategy to a calculated value reads empty in Cypher).",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:IndexPassThrough/param/unitIndex"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:IndexPassThrough/output/index"}]
      }
    },
    {
      "@id": "mcdonalds:IndexPassThrough/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "return unitIndex;"
    },
    {
      "@id": "mcdonalds:IndexPassThrough/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:IndexPassThrough"},
      "fno:implementation": {"@id": "mcdonalds:IndexPassThrough/impl"}
    },
    {
      "@id": "mcdonalds:IndexPassThrough/output/index",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/index"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:IndexPassThrough/param/unitIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/unitIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:InventoryDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "InventoryDate",
      "rdfs:comment": "yyyy-mm-dd of the latest daily count.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:Is24Hour",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Is24Hour",
      "rdfs:range": {"@id": "xsd:boolean"}
    },
    {
      "@id": "mcdonalds:IsCurrent",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "IsCurrent",
      "rdfs:comment": "Certification not expired as of the last compile.",
      "rdfs:range": {"@id": "xsd:boolean"}
    },
    {
      "@id": "mcdonalds:IsOpen",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "IsOpen",
      "rdfs:comment": "True when the operating status is Active.",
      "rdfs:range": {"@id": "xsd:boolean"}
    },
    {
      "@id": "mcdonalds:IsServing",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "IsServing",
      "rdfs:comment": "1 when the machine is serving right now (state 0), else 0.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:IsServingOf",
      "@type": "fno:Function",
      "rdfs:label": "Is Serving",
      "rdfs:comment": "1 when the soft serve state is Operational (0), else 0.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:IsServingOf/param/state"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:IsServingOf/output/serving"}]
      }
    },
    {
      "@id": "mcdonalds:IsServingOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (state.Value == null) return new TVQ(state.Timestamp, null, 0);\nreturn new TVQ(state.Timestamp, System.Convert.ToInt32(state.Value) == 0 ? 1 : 0, state.Quality);"
    },
    {
      "@id": "mcdonalds:IsServingOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:IsServingOf"},
      "fno:implementation": {"@id": "mcdonalds:IsServingOf/impl"}
    },
    {
      "@id": "mcdonalds:IsServingOf/output/serving",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/serving"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:IsServingOf/param/state",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/state"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:IssuingBody",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "IssuingBody",
      "rdfs:range": {"@id": "xsd:string"}
