      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:WorstHealthIndex",
      "@type": "fno:Function",
      "rdfs:label": "Worst Health Index",
      "rdfs:comment": "Store health: the lowest of its four equipment health indexes (missing inputs ignored).",
      "fno:expects": {
        "@list": [
          {"@id": "mcdonalds:WorstHealthIndex/param/coolerIndex"},
          {"@id": "mcdonalds:WorstHealthIndex/param/freezerIndex"},
          {"@id": "mcdonalds:WorstHealthIndex/param/hvacIndex"},
          {"@id": "mcdonalds:WorstHealthIndex/param/generatorIndex"}
        ]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:WorstHealthIndex/output/index"}]
      }
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "TVQ[] all = { coolerIndex, freezerIndex, hvacIndex, generatorIndex };\ndouble? min = null; var ts = coolerIndex.Timestamp; var q = coolerIndex.Quality;\nforeach (var t in all) {\n    if (t.Timestamp > ts) ts = t.Timestamp;\n    if (t.Value == null) continue;\n    double v = System.Convert.ToDouble(t.Value);\n    if (min == null || v < min) { min = v; q = t.Quality; }\n}\nreturn min == null ? new TVQ(ts, null, 0) : new TVQ(ts, min.Value, q);"
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:WorstHealthIndex"},
      "fno:implementation": {"@id": "mcdonalds:WorstHealthIndex/impl"}
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/output/index",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/index"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/param/coolerIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/coolerIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/param/freezerIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/freezerIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:WorstHealthIndex/param/generatorIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/generatorIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
