    {
      "@id": "mcdonalds:LocationType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "LocationType",
      "rdfs:range": {"@id": "xsd:string"},
      "enumType": "mcdonalds:LocationTypeEnum"
    },
    {
      "@id": "mcdonalds:LocationTypeEnum",
      "@type": "owl:Class",
      "rdfs:label": "Location Type",
      "rdfs:comment": "Kind of site the restaurant occupies; keys are ref.location_type codes in mcdonalds_ar.",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:string",
      "enumMembers": [
        {"rdfs:label": "Freestanding", "enumKey": "FREESTANDING", "enumName": "Freestanding"},
        {"rdfs:label": "Gas Station", "enumKey": "GAS_STATION", "enumName": "GasStation"},
        {"rdfs:label": "Wal*Mart", "enumKey": "WALMART", "enumName": "Walmart"}
      ]
    },
    {
      "@id": "mcdonalds:Longitude",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Longitude",
      "rdfs:comment": "WGS84 decimal degrees.",
      "rdfs:range": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:LostSalesUsd7d",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "LostSalesUsd7d",
      "rdfs:comment": "Treat sales lost to faults over the last 7 days: DownHours7d x DowntimeRevenuePerHourUsd.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:LostSalesUsdOf",
      "@type": "fno:Function",
      "rdfs:label": "Lost Sales (USD)",
      "rdfs:comment": "Treat sales lost to downtime: downHours x revenuePerHour.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:LostSalesUsdOf/param/downHours"}, {"@id": "mcdonalds:LostSalesUsdOf/param/revenuePerHour"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:LostSalesUsdOf/output/usd"}]
      }
    },
    {
      "@id": "mcdonalds:LostSalesUsdOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (downHours.Value == null) return new TVQ(downHours.Timestamp, null, 0);\nreturn new TVQ(downHours.Timestamp, System.Math.Round(System.Convert.ToDouble(downHours.Value) * revenuePerHour, 0), downHours.Quality);"
    },
    {
      "@id": "mcdonalds:LostSalesUsdOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:LostSalesUsdOf"},
      "fno:implementation": {"@id": "mcdonalds:LostSalesUsdOf/impl"}
    },
    {
      "@id": "mcdonalds:LostSalesUsdOf/output/usd",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/usd"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:LostSalesUsdOf/param/downHours",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/downHours"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
