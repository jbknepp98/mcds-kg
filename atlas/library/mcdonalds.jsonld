      "rdfs:range": {"@id": "xsd:boolean"}
    },
    {
      "@id": "mcdonalds:HealthIndex",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "HealthIndex",
      "rdfs:comment": "0-100. HealthIndex(HourlyAverage vs own baseline and vs design normal, worse of the two). 70+ Healthy, 40-70 Warning, below 40 Danger.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf",
      "@type": "fno:Function",
      "rdfs:label": "Health Index",
      "rdfs:comment": "0-100 health of a monitored unit. Compares the hourly steady-state average with the unit's own baseline (z = (avg - mean) / stdev) and with the design normal (z = (avg - normal) / tolerance), takes the worse (only running high counts), then index = 100 - 25 x (z - 1), clamped 0-100. So within 1 sigma = 100, 2.2 sigma = 70 (Warning), 3.4 sigma = 40 (Danger). The design check matters because a unit that has always run hot looks normal against its own history.",
      "fno:expects": {
        "@list": [
          {"@id": "mcdonalds:HealthIndexOf/param/hourlyAverage"},
          {"@id": "mcdonalds:HealthIndexOf/param/baselineMean"},
          {"@id": "mcdonalds:HealthIndexOf/param/baselineStdDev"},
          {"@id": "mcdonalds:HealthIndexOf/param/normalValue"},
          {"@id": "mcdonalds:HealthIndexOf/param/normalTolerance"}
        ]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:HealthIndexOf/output/index"}]
      }
    },
    {
      "@id": "mcdonalds:HealthIndexOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (hourlyAverage.Value == null || baselineMean.Value == null || baselineStdDev.Value == null || normalTolerance <= 0)\n    return new TVQ(hourlyAverage.Timestamp, null, 0);\ndouble a = System.Convert.ToDouble(hourlyAverage.Value);\ndouble m = System.Convert.ToDouble(baselineMean.Value);\ndouble s = System.Math.Max(System.Convert.ToDouble(baselineStdDev.Value), 1e-6);\ndouble z = System.Math.Max((a - m) / s, (a - normalValue) / normalTolerance);\ndouble idx = System.Math.Round(System.Math.Clamp(100.0 - 25.0 * System.Math.Max(0.0, z - 1.0), 0.0, 100.0), 1);\nreturn new TVQ(hourlyAverage.Timestamp, idx, hourlyAverage.Quality);"
    },
    {
      "@id": "mcdonalds:HealthIndexOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:HealthIndexOf"},
      "fno:implementation": {"@id": "mcdonalds:HealthIndexOf/impl"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/output/index",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/index"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/param/baselineMean",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/baselineMean"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/param/baselineStdDev",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/baselineStdDev"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/param/hourlyAverage",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/hourlyAverage"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/param/normalTolerance",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/normalTolerance"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:HealthIndexOf/param/normalValue",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/normalValue"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:HealthStatusEnum",
      "@type": "owl:Class",
      "rdfs:label": "Health Status",
      "rdfs:comment": "Risk band for a live analog reading, produced by ClassifyHealth.",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:integer",
      "enumMembers": [
        {"rdfs:label": "Healthy", "enumKey": 0, "enumName": "Healthy"},
        {"rdfs:label": "Warning", "enumKey": 1, "enumName": "Warning"},
        {"rdfs:label": "Danger", "enumKey": 2, "enumName": "Danger"}
      ]
    },
    {
      "@id": "mcdonalds:HireDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "HireDate",
      "rdfs:comment": "yyyy-mm-dd",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:HomeStoreId",
