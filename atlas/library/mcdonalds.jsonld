{
  "@context": [
    "atlas-core.jsonld",
    "atlas-common.jsonld",
    {
      "mcdonalds": "urn:atlas:ontology:mcdonalds:"
    }
  ],
  "@graph": [
    {
      "@id": "urn:atlas:ontology:mcdonalds",
      "@type": "owl:Ontology",
      "rdfs:label": "mcdonalds Library",
      "rdfs:comment": "McDonald's Arkansas field-service model: the enterprise, its territories (regions) and restaurants, and the store equipment the simulator reports on (walk-in cooler, walk-in freezer, rooftop HVAC, backup generator, soft serve machine) with live state and reading signals, state code lists matching the simulator, and a Healthy/Warning/Danger classifier. Store and territory records come from the mcdonalds_ar Postgres database; signals from the Historian dataset McDonalds."
    },
    {
      "@id": "mcdonalds:Address",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Address",
      "rdfs:comment": "Street address.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:AssignedSince",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "AssignedSince",
      "rdfs:comment": "yyyy-mm-dd the current truck assignment started.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:BaselineMean",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "BaselineMean",
      "rdfs:comment": "Reference the hourly average is compared with: mean of the unit's hourly steady-state means over 3 days, or the class normal when BaselineMode = 0. Recomputed hourly.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:BaselineMode",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "BaselineMode",
      "rdfs:comment": "BaselineModeEnum: 1 = own 3-day baseline, 0 = defined normal operation (too little variation in 3 days, e.g. a generator that sat in standby).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:BaselineModeEnum",
      "@type": "owl:Class",
      "rdfs:label": "Baseline Mode",
      "rdfs:comment": "Which reference the health index used: the unit's own 3-day baseline, or defined normal operation when the unit showed too little variation.",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:integer",
      "enumMembers": [
        {"rdfs:label": "Normal operation", "enumKey": 0, "enumName": "NormalOperation"},
        {"rdfs:label": "Own 3-day baseline", "enumKey": 1, "enumName": "OwnBaseline"}
      ]
    },
    {
      "@id": "mcdonalds:BaselineStdDev",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "BaselineStdDev",
      "rdfs:comment": "Spread of the baseline (stdev of hourly means, floored at half the normal tolerance; the normal tolerance when BaselineMode = 0).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:CertLevel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "CertLevel",
      "rdfs:range": {"@id": "xsd:string"},
      "enumType": "mcdonalds:CertLevelEnum"
    },
    {
      "@id": "mcdonalds:CertLevelEnum",
      "@type": "owl:Class",
      "rdfs:label": "Technician Level",
      "rdfs:subClassOf": [{"@id": "atlas:NodeBase"}, {"@id": "atlas:EnumerationType"}],
      "enumKeyType": "xsd:string",
      "enumMembers": [
        {"rdfs:label": "Apprentice", "enumKey": "APPRENTICE", "enumName": "Apprentice"},
        {"rdfs:label": "Technician", "enumKey": "TECHNICIAN", "enumName": "Technician"},
        {"rdfs:label": "Senior Technician", "enumKey": "SENIOR", "enumName": "Senior"}
      ]
    },
    {
      "@id": "mcdonalds:CertificateNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "CertificateNumber",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:Certification",
      "@type": "owl:Class",
      "rdfs:label": "Certification",
      "rdfs:comment": "A credential a repair task may require (EPA 608, refrigeration, HVAC, generator, soft serve).",
      "rdfs:subClassOf": [
        {"@id": "atlas:NodeBase"},
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Name"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:CertificationCode"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:IssuingBody"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        }
      ]
    },
    {
      "@id": "mcdonalds:CertificationCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "CertificationCode",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:City",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "City",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:ClassifyHealth",
      "@type": "fno:Function",
      "rdfs:label": "Classify Health",
      "rdfs:comment": "Bands a live reading: 0 Healthy below healthyThreshold, 1 Warning below dangerThreshold, 2 Danger at or above it. Keeps the input timestamp and quality.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:ClassifyHealth/param/value"}, {"@id": "mcdonalds:ClassifyHealth/param/healthyThreshold"}, {"@id": "mcdonalds:ClassifyHealth/param/dangerThreshold"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:ClassifyHealth/output/status"}]
      }
    },
    {
      "@id": "mcdonalds:ClassifyHealth/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (value.Value == null) return new TVQ(value.Timestamp, null, 0);\ndouble v = System.Convert.ToDouble(value.Value);\nif (v < healthyThreshold) return new TVQ(value.Timestamp, 0, value.Quality);\nif (v < dangerThreshold) return new TVQ(value.Timestamp, 1, value.Quality);\nreturn new TVQ(value.Timestamp, 2, value.Quality);"
    },
    {
      "@id": "mcdonalds:ClassifyHealth/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:ClassifyHealth"},
      "fno:implementation": {"@id": "mcdonalds:ClassifyHealth/impl"}
    },
    {
      "@id": "mcdonalds:ClassifyHealth/output/status",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/status"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ClassifyHealth/param/dangerThreshold",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/dangerThreshold"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:ClassifyHealth/param/healthyThreshold",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/healthyThreshold"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:ClassifyHealth/param/value",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/value"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ConditionAnswered",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ConditionAnswered",
      "rdfs:comment": "The ServiceCondition this task fixes (1 Warning, 2 Danger, 3 Fault).",
      "rdfs:range": {"@id": "xsd:integer"},
      "enumType": "mcdonalds:ServiceConditionEnum"
    },
    {
      "@id": "mcdonalds:Cooler",
      "@type": "owl:Class",
      "rdfs:label": "Walk-in Cooler",
      "rdfs:comment": "Walk-in cooler holding refrigerated product above freezing. Healthy below 41 °F, Danger at 45 °F and above.",
      "rdfs:subClassOf": {"@id": "mcdonalds:RefrigeratedUnit"}
    },
    {
      "@id": "mcdonalds:CoolerHealthIndex",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "CoolerHealthIndex",
      "rdfs:comment": "Health matrix: the store's cooler HealthIndex.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:County",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "County",
      "rdfs:comment": "County name, e.g. Pulaski County.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:CustomerHearsBroken",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "CustomerHearsBroken",
      "rdfs:comment": "1 when a customer asking for a McFlurry would be told the machine is broken: heat treat (10), mix low (20) or Needs Service (40). It's not always broken - sometimes it's cleaning.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:CustomerHearsBrokenOf",
      "@type": "fno:Function",
      "rdfs:label": "Customer Hears Broken",
      "rdfs:comment": "1 when the customer would be told 'the machine is broken': heat treat (10), mix low (20) or Needs Service (40). Only 40 is actually broken.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:CustomerHearsBrokenOf/param/state"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:CustomerHearsBrokenOf/output/hearsBroken"}]
      }
    },
    {
      "@id": "mcdonalds:CustomerHearsBrokenOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "if (state.Value == null) return new TVQ(state.Timestamp, null, 0);\nint c = System.Convert.ToInt32(state.Value);\nreturn new TVQ(state.Timestamp, (c == 10 || c == 20 || c >= 40) ? 1 : 0, state.Quality);"
    },
    {
      "@id": "mcdonalds:CustomerHearsBrokenOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:CustomerHearsBrokenOf"},
      "fno:implementation": {"@id": "mcdonalds:CustomerHearsBrokenOf/impl"}
    },
    {
      "@id": "mcdonalds:CustomerHearsBrokenOf/output/hearsBroken",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/hearsBroken"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:CustomerHearsBrokenOf/param/state",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/state"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMiles",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "DetourAllowanceMiles",
      "rdfs:comment": "Extra road miles worth driving to fix this unit now: MaxDetourMiles x urgency, where urgency rises from 0 at health index 100 to 1 at 40 and below. 0 for healthy units and detected faults (soft serve faults excepted, for fun).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf",
      "@type": "fno:Function",
      "rdfs:label": "Detour Allowance (miles)",
      "rdfs:comment": "How many extra road miles this unit is worth right now: maxDetourMiles x urgency, urgency = (100 - healthIndex) / 60 clamped 0-1 (0 at index 100, full at 40 and below). Only undetected conditions (1, 2) earn a detour; healthy units and detected faults get 0. Consequence lives in maxDetourMiles: freezer 40, cooler 30, HVAC 15, generator 5.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:DetourAllowanceMilesOf/param/healthIndex"}, {"@id": "mcdonalds:DetourAllowanceMilesOf/param/condition"}, {"@id": "mcdonalds:DetourAllowanceMilesOf/param/maxDetourMiles"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:DetourAllowanceMilesOf/output/miles"}]
      }
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "int c = condition.Value == null ? 0 : System.Convert.ToInt32(condition.Value);\nif ((c != 1 && c != 2) || healthIndex.Value == null) return new TVQ(condition.Timestamp, 0.0, condition.Quality);\ndouble u = System.Math.Clamp((100.0 - System.Convert.ToDouble(healthIndex.Value)) / 60.0, 0.0, 1.0);\nreturn new TVQ(healthIndex.Timestamp, System.Math.Round(maxDetourMiles * u, 1), healthIndex.Quality);"
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:DetourAllowanceMilesOf"},
      "fno:implementation": {"@id": "mcdonalds:DetourAllowanceMilesOf/impl"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/output/miles",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/miles"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/param/condition",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/condition"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/param/healthIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/healthIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DetourAllowanceMilesOf/param/maxDetourMiles",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/maxDetourMiles"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:DownHours7d",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "DownHours7d",
      "rdfs:comment": "Hours in fault over the last 7 days.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DownMinutes",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "DownMinutes",
      "rdfs:comment": "Length of the current outage in minutes (0 when not faulted).",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:DowntimeRevenuePerHourUsd",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "DowntimeRevenuePerHourUsd",
      "rdfs:comment": "Treat sales lost per hour of downtime (ref.equipment_class: ~12 treats/h x ~$3.49).",
      "rdfs:range": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:DriveMinutes",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "DriveMinutes",
      "rdfs:comment": "Estimated drive time at a 50 mph average.",
      "rdfs:range": {"@id": "xsd:integer"}
    },
    {
      "@id": "mcdonalds:DriveThruHours",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "DriveThruHours",
      "rdfs:comment": "Drive-thru hours as published; empty where none is published.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:Enterprise",
      "@type": "owl:Class",
      "rdfs:label": "Enterprise",
      "rdfs:comment": "The operating organisation at the top of the hierarchy (McDonald's Arkansas). Contains territories.",
      "rdfs:subClassOf": [
        {"@id": "atlas:NodeBase"},
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:Name"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        }
      ]
    },
    {
      "@id": "mcdonalds:EquipmentClassCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "EquipmentClassCode",
      "rdfs:comment": "COOLER, FREEZER, HVAC, GENERATOR or SOFTSERVE (ref.equipment_class). Joins equipment to the repair tasks for its class.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:EstMinutes",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "EstMinutes",
      "rdfs:range": {"@id": "xsd:integer"}
    },
    {
      "@id": "mcdonalds:ExpiresDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ExpiresDate",
      "rdfs:comment": "yyyy-mm-dd; empty = does not expire.",
      "rdfs:range": {"@id": "xsd:string"}
    },
    {
      "@id": "mcdonalds:ExposureUsd",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "ExposureUsd",
      "rdfs:comment": "Product or cost at risk if the undetected issue is not caught: ProductAtRiskUsd x urgency.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ExposureUsdOf",
      "@type": "fno:Function",
      "rdfs:label": "Exposure (USD)",
      "rdfs:comment": "Product or cost at risk from an undetected issue: productAtRiskUsd x urgency (same urgency as DetourAllowanceMilesOf).",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:ExposureUsdOf/param/healthIndex"}, {"@id": "mcdonalds:ExposureUsdOf/param/condition"}, {"@id": "mcdonalds:ExposureUsdOf/param/productAtRiskUsd"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:ExposureUsdOf/output/usd"}]
      }
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "int c = condition.Value == null ? 0 : System.Convert.ToInt32(condition.Value);\nif ((c != 1 && c != 2) || healthIndex.Value == null) return new TVQ(condition.Timestamp, 0.0, condition.Quality);\ndouble u = System.Math.Clamp((100.0 - System.Convert.ToDouble(healthIndex.Value)) / 60.0, 0.0, 1.0);\nreturn new TVQ(healthIndex.Timestamp, System.Math.Round(productAtRiskUsd * u, 0), healthIndex.Quality);"
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:ExposureUsdOf"},
      "fno:implementation": {"@id": "mcdonalds:ExposureUsdOf/impl"}
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/output/usd",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/usd"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/param/condition",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/condition"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/param/healthIndex",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/healthIndex"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:ExposureUsdOf/param/productAtRiskUsd",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/productAtRiskUsd"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:Failures7d",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Failures7d",
      "rdfs:comment": "Times the machine went into Needs Service in the last 7 days.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf",
      "@type": "fno:Function",
      "rdfs:label": "Fault Detour Allowance (miles)",
      "rdfs:comment": "Soft serve only, for fun: a machine down in Needs Service is worth the full maxDetourMiles.",
      "fno:expects": {
        "@list": [{"@id": "mcdonalds:FaultDetourAllowanceMilesOf/param/condition"}, {"@id": "mcdonalds:FaultDetourAllowanceMilesOf/param/maxDetourMiles"}]
      },
      "fno:returns": {
        "@list": [{"@id": "mcdonalds:FaultDetourAllowanceMilesOf/output/miles"}]
      }
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf/impl",
      "@type": "atlas:CSharpFunctionImplementation",
      "body": "int c = condition.Value == null ? 0 : System.Convert.ToInt32(condition.Value);\nreturn new TVQ(condition.Timestamp, c == 3 ? maxDetourMiles : 0.0, condition.Quality);"
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf/mapping",
      "@type": "fno:Mapping",
      "fno:function": {"@id": "mcdonalds:FaultDetourAllowanceMilesOf"},
      "fno:implementation": {"@id": "mcdonalds:FaultDetourAllowanceMilesOf/impl"}
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf/output/miles",
      "@type": "fno:Output",
      "fno:predicate": {"@id": "mcdonalds:output/miles"},
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf/param/condition",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/condition"},
      "fno:required": true,
      "fno:type": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:FaultDetourAllowanceMilesOf/param/maxDetourMiles",
      "@type": "fno:Parameter",
      "fno:predicate": {"@id": "mcdonalds:param/maxDetourMiles"},
      "fno:required": true,
      "fno:type": {"@id": "xsd:double"}
    },
    {
      "@id": "mcdonalds:Freezer",
      "@type": "owl:Class",
      "rdfs:label": "Walk-in Freezer",
      "rdfs:comment": "Walk-in freezer holding frozen product. Healthy below 0 °F, Danger at 10 °F and above.",
      "rdfs:subClassOf": {"@id": "mcdonalds:RefrigeratedUnit"}
    },
    {
      "@id": "mcdonalds:FreezerHealthIndex",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "FreezerHealthIndex",
      "rdfs:comment": "Health matrix: the store's freezer HealthIndex.",
      "rdfs:range": {"@id": "atlas-common:TVQ"}
    },
    {
      "@id": "mcdonalds:Generator",
      "@type": "owl:Class",
      "rdfs:label": "Backup Generator",
      "rdfs:comment": "Standby generator for utility outages; exercised on a schedule. Load healthy below 80 %, Danger at 90 % and above.",
      "rdfs:subClassOf": [
        {"@id": "mcdonalds:StoreEquipment"},
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:GeneratorState"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
