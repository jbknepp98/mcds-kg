        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:BaselineMean"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:BaselineStdDev"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:BaselineMode"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
          "owl:onProperty": {"@id": "mcdonalds:NormalValue"},
          "owl:minCardinality": {"@type": "xsd:nonNegativeInteger", "@value": "0"}
        },
        {
          "@type": "owl:Restriction",
